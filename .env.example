# Синтетические реквизиты локальной демобазы. Для URL используйте буквы и цифры.
POSTGRES_PASSWORD=localDemo2026
BUDDY_PORT=5050
# Включите 1 только для проверки имитатора согласования.
BUDDY_DEMO_OPERATOR=0

# AI_MODE=live requires a DeepSeek-compatible provider key. Keep secrets in .env.
# Set BUDDY_AGENT_FACTORY only together with AI_MODE=live (see ai/README.md).
AI_MODE=demo
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=8
BUDDY_AGENT_FACTORY=
BUDDY_AGENT_TIMEOUT=12
