# AI zone configuration template (task A0). Copy to ai/.env and fill locally.
# NEVER commit real keys. Placeholders below are not working secrets.
# Exact endpoint/model must be confirmed with the team (Web 2) before live use.

# Provider selection: openai_compatible = live LLM, demo = deterministic offline.
AI_PROVIDER=openai_compatible

# demo = default, reproducible, works WITHOUT any key (primary mode for
# development, tests and the jury run). live = real calls to an
# OpenAI-compatible chat-completions endpoint, requires the key and is
# explicitly marked via aiMode=live in every result.
AI_MODE=demo

# Required only when AI_MODE=live (validated at startup; live without a key
# fails loudly instead of silently falling back to demo). Any
# OpenAI-compatible endpoint works; DEEPSEEK_* names are accepted aliases.
AI_BASE_URL=<compatible-endpoint>
AI_MODEL=<model-name>
AI_API_KEY=<secret>
# Must stay below the server AgentRunner budget (10 s by default).
AI_TIMEOUT_SECONDS=8
