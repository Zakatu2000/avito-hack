# Base URL API. Empty — /api/* uses the same origin through Vite/nginx proxy.
# To switch to real services: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Enable standalone MSW demo explicitly with true. Real API uses false.
VITE_ENABLE_MSW=false

# Chat engine: keyword (deterministic) | llm (reserved for the future)
VITE_CHAT_ENGINE=keyword
