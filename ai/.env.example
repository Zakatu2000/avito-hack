# AI zone configuration template (task A0). Copy to ai/.env and fill locally.
# NEVER commit real keys. Placeholders below are not working secrets.
# Exact endpoint/model must be confirmed with the team (Web 2) before live use.

# Provider selection: deepseek = live LLM, demo = deterministic offline stub.
AI_PROVIDER=deepseek

# demo = default, reproducible, works WITHOUT any key (primary mode for
# development, tests and the jury run). live = real DeepSeek calls, requires
# the key and is explicitly marked via aiMode=live in every result.
AI_MODE=demo

# Required only when AI_MODE=live (validated at startup; live without a key
# fails loudly instead of silently falling back to demo).
DEEPSEEK_BASE_URL=<compatible-endpoint>
DEEPSEEK_MODEL=<model-name>
DEEPSEEK_API_KEY=<secret>
DEEPSEEK_TIMEOUT_SECONDS=15
